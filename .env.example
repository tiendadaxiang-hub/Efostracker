# Efostracker — Plantilla de configuración
# Copia este archivo a .env y edita con tus valores

# ═══ Scheduler ═══
EFOS_SCHEDULE_TIME=06:00
EFOS_RUN_ON_START=true

# ═══ Notificaciones ═══
EFOS_NOTIFY_ON_NEW=true
EFOS_SMTP_HOST=smtp.gmail.com
EFOS_SMTP_PORT=587
EFOS_SMTP_USER=tu_usuario@gmail.com
EFOS_SMTP_PASS=tu_contraseña_de_aplicacion
EFOS_NOTIFY_FROM=tu_usuario@gmail.com
EFOS_NOTIFY_TO=destinatario1@ejemplo.com,destinatario2@ejemplo.com