Screen {
    background: #0d1117;
    color: #00ff00;
}

Header {
    background: #161b22;
    color: #00ff00;
    text-style: bold;
}

Footer {
    background: #161b22;
    color: #00ff00;
}

#left-panel {
    width: 1fr;
    border-right: solid #00ff00;
}

#right-panel {
    width: 2fr;
    padding: 1 2;
}

#watchlist-title, #details-title {
    text-style: bold;
    color: #00ffff;
    background: #161b22;
    padding: 0 1;
    margin-bottom: 1;
}

#watchlist-table {
    height: 1fr;
    border: tall #00ff00;
}

#watchlist-table > .datatable--cursor {
    background: #00ff00;
    color: #0d1117;
}

#details-content {
    background: #161b22;
    border: tall #00ffff;
    padding: 1 2;
    height: 1fr;
}

#log-panel {
    height: 10;
    border: tall #ffff00;
    background: #000000;
    color: #ffff00;
}